{
  "manifest_version": 3,
  "name": "PerkPop",
  "version": "0.3.0",
  "description": "PerkPop surfaces cashback offers inline on Google Search results so you never miss savings.",
  "action": {
    "default_title": "PerkPop – Cashback on Google Search"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.google.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
